# ConnectSign AI Backend Environment Configuration (Placeholders and Safe Defaults)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Relative or absolute path to model artifacts directory
MODEL_DIR=models

# Uncertainty rejection threshold (calibrated for 32-class classifier)
UNCERTAINTY_THRESHOLD=0.12

# Allowed origins for CORS (comma-separated or configured in config.py)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://connect-sign-nine.vercel.app"]
